{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "HackerNews": {
    "BaseAddress": "https://hacker-news.firebaseio.com/v0/",
    "TimeoutSeconds": 5
  },
  "Stories": {
    "MaxCount": 200,
    "Parallelism": 10,
    "IdListTtlSeconds": 120,
    "ItemTtlSeconds": 600,
    "MaxCacheEntries": 1000
  }
}

